# Copy to .env.local for local development with `vercel dev`.
# In production these are set in Vercel → Settings → Environment Variables.

# Provided automatically when you connect a Neon database in Vercel → Storage
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# The FIRST admin account, created automatically on first run.
# After signing in once, manage everyone else in Settings → Users.
ADMIN_USERNAME=marcelo
ADMIN_PASSWORD=change-this-first
ADMIN_NAME=Marcelo Frazzato
